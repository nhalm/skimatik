// {{.FunctionName}}Paginated executes the {{.QueryName}} query with cursor-based pagination
// Sort order: {{range $index, $col := .OrderByColumns}}{{if $index}}, {{end}}{{$col.Name}} {{$col.Direction}}{{end}}
func (r *{{.RepositoryName}}) {{.FunctionName}}Paginated(ctx context.Context, db pgxkit.Executor{{.ParameterDeclarations}}, params PaginationParams) (*PaginationResult[{{.ResultType}}], error) {
	// Validate pagination parameters
	if err := validatePaginationParams(params); err != nil {
		return nil, err
	}

	// Set default limit
	limit := params.Limit
	if limit <= 0 {
		limit = 20
	}
	if limit > 100 {
		limit = 100
	}

	// Determine pagination direction
	isBackward := params.BeforeCursor != ""

	// Parse cursor if provided
	var cursorValue interface{}
	if params.NextCursor != "" {
		_, value, err := decodeJSONCursor(params.NextCursor)
		if err != nil {
			return nil, fmt.Errorf("invalid cursor format: %w", err)
		}
		cursorValue = value
	} else if params.BeforeCursor != "" {
		_, value, err := decodeJSONCursor(params.BeforeCursor)
		if err != nil {
			return nil, fmt.Errorf("invalid cursor format: %w", err)
		}
		cursorValue = value
	}

	// Build paginated query by wrapping the base query
	baseQuery := `{{.SQL}}`
	var paginatedQuery string

	{{- $firstCol := index .OrderByColumns 0}}
	{{- $orderBy := $firstCol.Name}}
	{{- $direction := $firstCol.Direction}}
	{{- $forwardOp := ">"}}{{if eq $direction "DESC"}}{{$forwardOp = "<"}}{{end}}
	{{- $backwardOp := "<"}}{{if eq $direction "DESC"}}{{$backwardOp = ">"}}{{end}}
	{{- $reverseDirection := "ASC"}}{{if eq $direction "ASC"}}{{$reverseDirection = "DESC"}}{{end}}

	if cursorValue != nil {
		if isBackward {
			// Backward pagination: reverse the operator and sort direction, then reverse results
			paginatedQuery = fmt.Sprintf(
				"SELECT * FROM (%s) AS subquery WHERE %s {{$backwardOp}} $%d ORDER BY %s {{$reverseDirection}} LIMIT $%d",
				baseQuery,
				"{{$orderBy}}",
				{{if .ParameterArgsOnly}}len([]interface{}{ {{.ParameterArgsOnly}} })+1{{else}}1{{end}},
				"{{$orderBy}}",
				{{if .ParameterArgsOnly}}len([]interface{}{ {{.ParameterArgsOnly}} })+2{{else}}2{{end}},
			)
		} else {
			// Forward pagination
			paginatedQuery = fmt.Sprintf(
				"SELECT * FROM (%s) AS subquery WHERE %s {{$forwardOp}} $%d ORDER BY %s {{$direction}} LIMIT $%d",
				baseQuery,
				"{{$orderBy}}",
				{{if .ParameterArgsOnly}}len([]interface{}{ {{.ParameterArgsOnly}} })+1{{else}}1{{end}},
				"{{$orderBy}}",
				{{if .ParameterArgsOnly}}len([]interface{}{ {{.ParameterArgsOnly}} })+2{{else}}2{{end}},
			)
		}
	} else {
		// No cursor, just add ORDER BY and LIMIT
		paginatedQuery = fmt.Sprintf(
			"SELECT * FROM (%s) AS subquery ORDER BY %s {{$direction}} LIMIT $%d",
			baseQuery,
			"{{$orderBy}}",
			{{if .ParameterArgsOnly}}len([]interface{}{ {{.ParameterArgsOnly}} })+1{{else}}1{{end}},
		)
	}

	// Build parameter list
	var args []interface{}
	{{if .ParameterArgsOnly}}
	args = append(args, {{.ParameterArgsOnly}})
	{{end}}
	if cursorValue != nil {
		args = append(args, cursorValue)
	}
	args = append(args, int32(limit+1)) // +1 to check if there are more results

	// Execute query
	rows, err := ExecuteReadQuery(ctx, db, "{{.QueryName}}_paginated", "{{.ResultType}}", paginatedQuery, args...)
	if err != nil {
		return nil, err
	}
	defer rows.Close()

	// Scan results
	var items []{{.ResultType}}
	for rows.Next() {
		var result {{.ResultType}}
		err := rows.Scan({{.ScanArgs}})
		if err != nil {
			return nil, HandleDatabaseError("scan", "{{.ResultType}}", err)
		}
		items = append(items, result)
	}

	if err := HandleRowsResult("{{.ResultType}}", rows); err != nil {
		return nil, err
	}

	// Check if there are more items in the direction we're paginating
	hasExtra := len(items) > limit
	if hasExtra {
		items = items[:limit] // Remove the extra item
	}

	// For backward pagination, reverse items to maintain correct order
	if isBackward {
		for i, j := 0, len(items)-1; i < j; i, j = i+1, j-1 {
			items[i], items[j] = items[j], items[i]
		}
	}

	// Determine hasMore and hasPrevious based on pagination direction
	var hasMore, hasPrevious bool
	if isBackward {
		hasPrevious = hasExtra
		hasMore = cursorValue != nil // If we used a cursor, there's more after
	} else {
		hasMore = hasExtra
		hasPrevious = cursorValue != nil // If we used a cursor, there's previous
	}

	// Generate cursors
	var nextCursor, beforeCursor string
	fieldName := toCamelCase("{{$orderBy}}")

	if hasMore && len(items) > 0 {
		lastItem := items[len(items)-1]
		v := reflect.ValueOf(lastItem)
		if v.Kind() == reflect.Ptr {
			v = v.Elem()
		}
		if v.Kind() == reflect.Struct {
			field := v.FieldByName(fieldName)
			if field.IsValid() {
				cursorVal := formatCursorValue(field.Interface())
				nextCursor, _ = encodeJSONCursor("{{$orderBy}}", cursorVal)
			}
		}
	}

	if hasPrevious && len(items) > 0 {
		firstItem := items[0]
		v := reflect.ValueOf(firstItem)
		if v.Kind() == reflect.Ptr {
			v = v.Elem()
		}
		if v.Kind() == reflect.Struct {
			field := v.FieldByName(fieldName)
			if field.IsValid() {
				cursorVal := formatCursorValue(field.Interface())
				beforeCursor, _ = encodeJSONCursor("{{$orderBy}}", cursorVal)
			}
		}
	}

	return &PaginationResult[{{.ResultType}}]{
		Items:        items,
		HasMore:      hasMore,
		HasPrevious:  hasPrevious,
		NextCursor:   nextCursor,
		BeforeCursor: beforeCursor,
	}, nil
}
