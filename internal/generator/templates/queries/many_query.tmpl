	validOrderBy := map[string]bool{
		{{range .CursorColumns}}"{{.}}": true,
		{{end}}
	}
	if !validOrderBy[orderBy] {
		return nil, fmt.Errorf("invalid orderBy column: %q (must be one of: {{range $index, $col := .CursorColumns}}{{if $index}}, {{end}}{{$col}}{{end}})", orderBy)
	}

	// Validate pagination parameters
	if err := validatePaginationParams(params); err != nil {
		return nil, err
	}

	// Set default limit
	limit := params.Limit
	if limit <= 0 {
		limit = 20
	}
	if limit > 100 {
		limit = 100
	}

	// Parse cursor if provided
	var cursorValue interface{}
	if params.NextCursor != "" {
		// Decode base64 cursor to get the actual value
		decoded, err := base64.URLEncoding.DecodeString(params.NextCursor)
		if err != nil {
			return nil, fmt.Errorf("invalid cursor format: %w", err)
		}
		cursorValue = string(decoded)
	}

	// Build paginated query by wrapping the base query
	baseQuery := `{{.SQL}}`
	var paginatedQuery string

	if cursorValue != nil {
		// Add WHERE clause for cursor pagination
		paginatedQuery = fmt.Sprintf(
			"SELECT * FROM (%s) AS subquery WHERE %s > $%d ORDER BY %s ASC LIMIT $%d",
			baseQuery,
			orderBy,
			{{if .ParameterArgsOnly}}len([]interface{}{ {{.ParameterArgsOnly}} })+1{{else}}1{{end}},
			orderBy,
			{{if .ParameterArgsOnly}}len([]interface{}{ {{.ParameterArgsOnly}} })+2{{else}}2{{end}},
		)
	} else {
		// No cursor, just add ORDER BY and LIMIT
		paginatedQuery = fmt.Sprintf(
			"SELECT * FROM (%s) AS subquery ORDER BY %s ASC LIMIT $%d",
			baseQuery,
			orderBy,
			{{if .ParameterArgsOnly}}len([]interface{}{ {{.ParameterArgsOnly}} })+1{{else}}1{{end}},
		)
	}

	// Build parameter list
	var args []interface{}
	{{if .ParameterArgsOnly}}
	args = append(args, {{.ParameterArgsOnly}})
	{{end}}
	if cursorValue != nil {
		args = append(args, cursorValue)
	}
	args = append(args, int32(limit+1)) // +1 to check if there are more results

	// Execute query
	rows, err := ExecuteQuery(ctx, r.db, "{{.QueryName}}_paginated", "{{.ResultType}}", paginatedQuery, args...)
	if err != nil {
		return nil, err
	}
	defer rows.Close()

	// Scan results
	var items []{{.ResultType}}
	for rows.Next() {
		var result {{.ResultType}}
		err := rows.Scan({{.ScanArgs}})
		if err != nil {
			return nil, HandleDatabaseError("scan", "{{.ResultType}}", err)
		}
		items = append(items, result)
	}

	if err := HandleRowsResult("{{.ResultType}}", rows); err != nil {
		return nil, err
	}

	// Check if there are more items
	hasMore := len(items) > limit
	if hasMore {
		items = items[:limit] // Remove the extra item
	}

	// Generate next cursor if there are more items
	var nextCursor string
	if hasMore && len(items) > 0 {
		lastItem := items[len(items)-1]

		// Extract the orderBy column value using reflection
		v := reflect.ValueOf(lastItem)
		fieldName := toCamelCase(orderBy)

		// Handle both struct and pointer to struct
		if v.Kind() == reflect.Ptr {
			v = v.Elem()
		}

		if v.Kind() != reflect.Struct {
			return nil, fmt.Errorf("cannot extract cursor from non-struct type")
		}

		field := v.FieldByName(fieldName)
		if !field.IsValid() {
			return nil, fmt.Errorf("field %q not found in result type for cursor", fieldName)
		}

		// Format the field value for cursor encoding
		cursorValue := formatCursorValue(field.Interface())
		cursorData, err := encodeJSONCursor(orderBy, cursorValue)
		if err != nil {
