// Create creates a new {{.StructName}} and writes an audit row to {{.AuditTableName}}.
// The parent INSERT and audit INSERT execute as a single CTE so they share the same
// statement-level NOW() timestamp and either both succeed or both fail.
func (r *{{.RepositoryName}}) Create(ctx context.Context, db pgxkit.Executor, params Create{{.StructName}}Params) (*{{.StructName}}, error) {
	id := r.generateIdFunc()
	query := `
		WITH inserted AS (
			INSERT INTO {{.TableName}} ({{.InsertColumns}})
			VALUES ({{.InsertPlaceholders}})
			RETURNING {{.SelectColumns}}
		),
		audited AS (
			INSERT INTO {{.AuditTableName}} (id, parent_id, version, snapshot, valid_from)
			SELECT gen_random_uuid(), id, 1, to_jsonb(inserted.*), NOW() FROM inserted
		)
		SELECT {{.SelectColumns}} FROM inserted
	`

	var {{.ReceiverName}} {{.StructName}}
	row := ExecuteQueryRow(ctx, db, "create", "{{.StructName}}", query, {{.InsertArgs}})
	err := row.Scan({{.ScanArgs}})
	if err := HandleQueryRowError("create", "{{.StructName}}", err); err != nil {
		return nil, err
	}

	return &{{.ReceiverName}}, nil
}
