// List retrieves all {{.StructName}}s
func (r *{{.RepositoryName}}) List(ctx context.Context, db pgxkit.Executor) ([]{{.StructName}}, error) {
	query := `
		SELECT {{.SelectColumns}}
		FROM {{.TableName}}
		ORDER BY {{.IDColumn}} ASC
	`

	rows, err := ExecuteReadQuery(ctx, db, "list", "{{.StructName}}", query)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	
	var results []{{.StructName}}
	for rows.Next() {
		var {{.ReceiverName}} {{.StructName}}
		err := rows.Scan({{.ScanArgs}})
		if err != nil {
			return nil, HandleDatabaseError("scan", "{{.StructName}}", err)
		}
		results = append(results, {{.ReceiverName}})
	}
	
	return results, HandleRowsResult("{{.StructName}}", rows)
} 