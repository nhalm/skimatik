// Test{{.StructName}}Repository provides comprehensive testing for {{.RepositoryName}}.
//
// Each sub-test is hermetic: it creates its own data and does not rely on
// state left by prior runs. Run with `TEST_DATABASE_URL` set to a writable
// Postgres; `pgxkit.RequireDB` skips the test if the variable is unset.
func Test{{.StructName}}Repository(t *testing.T) {
	t.Parallel()

	testDB := pgxkit.RequireDB(t)
	repo := New{{.RepositoryName}}(nil) // nil = default UUID v7 generator
	ctx := context.Background()

	t.Run("Create", func(t *testing.T) {
		params := Create{{.StructName}}Params{
			{{range .CreateFields}}{{.Name}}: {{.TestValue}},
			{{end}}
		}

		created, err := repo.Create(ctx, testDB.DB, params)
		require.NoError(t, err)
		require.NotNil(t, created)
		{{range .CreateFields}}require.Equal(t, params.{{.Name}}, created.{{.Name}})
		{{end}}
	})

	t.Run("Get", func(t *testing.T) {
		params := Create{{.StructName}}Params{
			{{range .CreateFields}}{{.Name}}: {{.TestValue}},
			{{end}}
		}

		created, err := repo.Create(ctx, testDB.DB, params)
		require.NoError(t, err)

		retrieved, err := repo.Get(ctx, testDB.DB, created.{{.IDField}})
		require.NoError(t, err)
		require.NotNil(t, retrieved)
		require.Equal(t, created.{{.IDField}}, retrieved.{{.IDField}})
	})

	t.Run("GetNotFound", func(t *testing.T) {
		nonExistentID := uuid.New()
		retrieved, err := repo.Get(ctx, testDB.DB, nonExistentID)
		require.Error(t, err)
		require.Nil(t, retrieved)
		require.Contains(t, err.Error(), "not found")
	})

	t.Run("Update", func(t *testing.T) {
		createParams := Create{{.StructName}}Params{
			{{range .CreateFields}}{{.Name}}: {{.TestValue}},
			{{end}}
		}

		created, err := repo.Create(ctx, testDB.DB, createParams)
		require.NoError(t, err)

		updateParams := Update{{.StructName}}Params{
			{{.IDField}}: created.{{.IDField}},
			{{range .UpdateFields}}{{.Name}}: {{.UpdateTestValue}},
			{{end}}
		}

		updated, err := repo.Update(ctx, testDB.DB, updateParams)
		require.NoError(t, err)
		require.NotNil(t, updated)
		require.Equal(t, created.{{.IDField}}, updated.{{.IDField}})
		{{range .UpdateFields}}require.Equal(t, updateParams.{{.Name}}, updated.{{.Name}})
		{{end}}
	})

	t.Run("Delete", func(t *testing.T) {
		params := Create{{.StructName}}Params{
			{{range .CreateFields}}{{.Name}}: {{.TestValue}},
			{{end}}
		}

		created, err := repo.Create(ctx, testDB.DB, params)
		require.NoError(t, err)

		err = repo.Delete(ctx, testDB.DB, created.{{.IDField}})
		require.NoError(t, err)

		retrieved, err := repo.Get(ctx, testDB.DB, created.{{.IDField}})
		require.Error(t, err)
		require.Nil(t, retrieved)
	})

	t.Run("List", func(t *testing.T) {
		var created []{{.StructName}}
		for i := 0; i < 3; i++ {
			params := Create{{.StructName}}Params{
				{{range .CreateFields}}{{.Name}}: {{.TestValueFunc}}(i),
				{{end}}
			}

			record, err := repo.Create(ctx, testDB.DB, params)
			require.NoError(t, err)
			created = append(created, *record)
		}

		results, err := repo.List(ctx, testDB.DB)
		require.NoError(t, err)
		require.GreaterOrEqual(t, len(results), 3)

		createdIDs := make(map[uuid.UUID]bool)
		for _, record := range created {
			createdIDs[record.{{.IDField}}] = true
		}

		foundCount := 0
		for _, result := range results {
			if createdIDs[result.{{.IDField}}] {
				foundCount++
			}
		}
		require.Equal(t, 3, foundCount)
	})

	t.Run("HealthCheck", func(t *testing.T) {
		err := repo.HealthCheck(ctx, testDB.DB)
		require.NoError(t, err)
	})

	t.Run("HealthCheckDetailed", func(t *testing.T) {
		status, err := repo.HealthCheckDetailed(ctx, testDB.DB)
		require.NoError(t, err)
		require.NotNil(t, status)
		require.True(t, status.Healthy)
		require.Equal(t, "{{.TableName}}", status.TableName)
		require.Equal(t, "{{.RepositoryName}}", status.Repository)
		require.Contains(t, status.Checks, "connection")
		require.Equal(t, "OK", status.Checks["connection"])
	})

	t.Run("RetryMethods", func(t *testing.T) {
		params := Create{{.StructName}}Params{
			{{range .CreateFields}}{{.Name}}: {{.TestValue}},
			{{end}}
		}

		created, err := repo.CreateWithRetry(ctx, testDB.DB, params)
		require.NoError(t, err)
		require.NotNil(t, created)

		retrieved, err := repo.GetWithRetry(ctx, testDB.DB, created.{{.IDField}})
		require.NoError(t, err)
		require.NotNil(t, retrieved)
		require.Equal(t, created.{{.IDField}}, retrieved.{{.IDField}})

		results, err := repo.ListWithRetry(ctx, testDB.DB)
		require.NoError(t, err)
		require.NotEmpty(t, results)
	})
}

// Test{{.StructName}}Repository_Golden locks in the full DB-event transcript
// (BEGIN, every Query/Exec with sql/args/rows, COMMIT/ROLLBACK) of a
// Create + Get scenario against the generated repository. A diff against the
// committed baseline at testdata/golden/Test{{.StructName}}Repository_Golden.json
// catches any change in which SQL skimatik emits or which rows it returns —
// the contract a code generator owes its users.
//
// Regenerate the baseline (after an intentional change) with:
//
//	go test -run Test{{.StructName}}Repository_Golden -overwrite-golden ./...
//
// Default normalizers handle UUIDs and timestamps; if your CreateFields embed
// per-run values that aren't UUID/time-typed, register a custom normalizer
// via pgxkit.WithGoldenNormalizer.
func Test{{.StructName}}Repository_Golden(t *testing.T) {
	t.Parallel()

	testDB := pgxkit.RequireDB(t)
	golden := testDB.EnableGolden("Test{{.StructName}}Repository_Golden")
	repo := New{{.RepositoryName}}(nil)
	ctx := context.Background()

	params := Create{{.StructName}}Params{
		{{range .CreateFields}}{{.Name}}: {{.TestValue}},
		{{end}}
	}

	created, err := repo.Create(ctx, golden, params)
	require.NoError(t, err)
	require.NotNil(t, created)

	retrieved, err := repo.Get(ctx, golden, created.{{.IDField}})
	require.NoError(t, err)
	require.NotNil(t, retrieved)

	golden.AssertGolden(t, "Test{{.StructName}}Repository_Golden")
}

// Test{{.StructName}}Repository_Plan locks in the structural EXPLAIN plan
// (FORMAT JSON, COSTS OFF) of the same Create + Get scenario. A diff against
// the committed baseline at testdata/plans/Test{{.StructName}}Repository_Plan.json
// catches plan-shape regressions: seq-scan vs index-scan, nested-loop vs
// hash-join, new sort nodes, join-order changes. It does not assert row data.
//
// Plans are PostgreSQL-version-sensitive — pin your test image to the same
// version your CI uses, or baselines will flake.
func Test{{.StructName}}Repository_Plan(t *testing.T) {
	t.Parallel()

	testDB := pgxkit.RequireDB(t)
	plan := testDB.EnableAssertPlan("Test{{.StructName}}Repository_Plan")
	repo := New{{.RepositoryName}}(nil)
	ctx := context.Background()

	params := Create{{.StructName}}Params{
		{{range .CreateFields}}{{.Name}}: {{.TestValue}},
		{{end}}
	}

	created, err := repo.Create(ctx, plan, params)
	require.NoError(t, err)

	_, err = repo.Get(ctx, plan, created.{{.IDField}})
	require.NoError(t, err)

	plan.AssertPlan(t, "Test{{.StructName}}Repository_Plan")
}

// Test{{.StructName}}RepositoryTimeout tests timeout handling.
func Test{{.StructName}}RepositoryTimeout(t *testing.T) {
	t.Parallel()

	testDB := pgxkit.RequireDB(t)
	repo := New{{.RepositoryName}}(nil)

	ctx, cancel := context.WithTimeout(context.Background(), time.Nanosecond)
	defer cancel()

	time.Sleep(time.Millisecond)

	t.Run("CreateTimeout", func(t *testing.T) {
		params := Create{{.StructName}}Params{
			{{range .CreateFields}}{{.Name}}: {{.TestValue}},
			{{end}}
		}

		_, err := repo.Create(ctx, testDB.DB, params)
		require.Error(t, err)
		require.Contains(t, err.Error(), "context")
	})

	t.Run("GetTimeout", func(t *testing.T) {
		id := uuid.New()
		_, err := repo.Get(ctx, testDB.DB, id)
		require.Error(t, err)
		require.Contains(t, err.Error(), "context")
	})
}

// Test{{.StructName}}RepositoryConstraints tests database constraint handling.
func Test{{.StructName}}RepositoryConstraints(t *testing.T) {
	t.Parallel()

	testDB := pgxkit.RequireDB(t)
	repo := New{{.RepositoryName}}(nil)
	ctx := context.Background()

	{{if .HasUniqueConstraints}}
	t.Run("UniqueConstraint", func(t *testing.T) {
		params := Create{{.StructName}}Params{
			{{range .CreateFields}}{{.Name}}: {{.TestValue}},
			{{end}}
		}

		_, err := repo.Create(ctx, testDB.DB, params)
		require.NoError(t, err)

		_, err = repo.Create(ctx, testDB.DB, params)
		require.Error(t, err)
		require.Contains(t, err.Error(), "already exists")
	})
	{{end}}
}
