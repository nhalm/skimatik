// {{.RepositoryName}} provides database operations for {{.TableName}}
type {{.RepositoryName}} struct {
	db             *pgxkit.DB
	{{if .IsUUIDType -}}
	generateIdFunc func() {{.IDType}}
	{{else -}}
	// generateIdFunc must be set by user for non-UUID types
	generateIdFunc func() {{.IDType}}
	{{end -}}
}

// New{{.RepositoryName}} creates a new {{.RepositoryName}}
// idGen: ID generator function. Pass nil to use default UUID v7 generator.
func New{{.RepositoryName}}(db *pgxkit.DB, idGen func() {{.IDType}}) *{{.RepositoryName}} {
	{{if .IsUUIDType -}}
	if idGen == nil {
		idGen = UUIDv7
