// ListPaginated retrieves {{.StructName}}s with cursor-based pagination
func (r *{{.RepositoryName}}) ListPaginated(ctx context.Context, db pgxkit.Executor, params PaginationParams) (*PaginationResult[{{.StructName}}], error) {
	// Validate parameters
	if err := validatePaginationParams(params); err != nil {
		return nil, err
	}

	// Set default limit
	limit := params.Limit
	if limit <= 0 {
		limit = 20
	}
	if limit > 100 {
		limit = 100
	}

	// Set default order by column
	orderBy := params.OrderBy
	if orderBy == "" {
		orderBy = "{{.IDColumn}}"
	}

	// Validate orderBy is allowed (only id for ListPaginated)
	allowedColumns := []string{"{{.IDColumn}}"}
	if err := validateOrderByColumn(orderBy, allowedColumns); err != nil {
		return nil, err
	}

	// Determine direction and cursor
	var cursor *string
	var direction string
	var orderDirection string

	if params.BeforeCursor != "" {
		// Backward pagination
		cursorColumn, value, err := decodeJSONCursor(params.BeforeCursor)
		if err != nil {
			return nil, fmt.Errorf("invalid before_cursor: %w", err)
		}
		if cursorColumn != orderBy {
			return nil, fmt.Errorf("cursor column %q does not match order_by column %q", cursorColumn, orderBy)
		}
		direction = "<"
		orderDirection = "DESC"
		cursorStr := fmt.Sprintf("%v", value)
		cursor = &cursorStr
	} else if params.NextCursor != "" {
		// Forward pagination
		cursorColumn, value, err := decodeJSONCursor(params.NextCursor)
		if err != nil {
			return nil, fmt.Errorf("invalid next_cursor: %w", err)
		}
		if cursorColumn != orderBy {
			return nil, fmt.Errorf("cursor column %q does not match order_by column %q", cursorColumn, orderBy)
		}
		direction = ">"
		orderDirection = "ASC"
		cursorStr := fmt.Sprintf("%v", value)
		cursor = &cursorStr
	} else {
		// No cursor - start from beginning
		direction = ">"
		orderDirection = "ASC"
	}

	// Build the query
	query := fmt.Sprintf(`
		SELECT {{.SelectColumns}}
		FROM {{.TableName}}
		WHERE ($1::text IS NULL OR %s %s $1::%s)
		ORDER BY %s %s
		LIMIT $2
	`, orderBy, direction, "{{.IDColumnType}}", orderBy, orderDirection)

	// Execute query with limit + 1 to check if there are more items
	rows, err := ExecuteReadQuery(ctx, db, "list_paginated", "{{.StructName}}", query, cursor, int32(limit+1))
	if err != nil {
		return nil, fmt.Errorf("pagination query failed: %w", err)
	}
	defer rows.Close()

	var items []{{.StructName}}
	for rows.Next() {
		var {{.ReceiverName}} {{.StructName}}
		err := rows.Scan({{.ScanArgs}})
		if err != nil {
			return nil, HandleDatabaseError("scan", "{{.StructName}}", err)
		}
		items = append(items, {{.ReceiverName}})
	}

	if err := HandleRowsResult("{{.StructName}}", rows); err != nil {
		return nil, err
	}

	// Check if there are more items
	hasMore := len(items) > limit
	if hasMore {
		items = items[:limit]
	}

	// If we paginated backward, reverse the results
	if params.BeforeCursor != "" {
		for i, j := 0, len(items)-1; i < j; i, j = i+1, j-1 {
			items[i], items[j] = items[j], items[i]
		}
	}

	// Generate cursors if there are items
	var nextCursor string
	var beforeCursor string

	if len(items) > 0 {
		firstItem := items[0]
		lastItem := items[len(items)-1]

		// Encode next cursor if there are more items forward
		if hasMore && params.BeforeCursor == "" {
			formattedValue := formatCursorValue(lastItem.GetID())
			nextCursor, _ = encodeJSONCursor(orderBy, formattedValue)
		}

		// Encode before cursor if there are items before
		if params.NextCursor != "" || params.BeforeCursor != "" {
			formattedValue := formatCursorValue(firstItem.GetID())
			beforeCursor, _ = encodeJSONCursor(orderBy, formattedValue)
		}

		// Special case: if we paginated backward and there are more items
		if hasMore && params.BeforeCursor != "" {
			formattedValue := formatCursorValue(firstItem.GetID())
			beforeCursor, _ = encodeJSONCursor(orderBy, formattedValue)
		}
	}

	hasPrevious := params.NextCursor != "" || (params.BeforeCursor != "" && hasMore)

	return &PaginationResult[{{.StructName}}]{
		Items:        items,
		HasMore:      hasMore && params.BeforeCursor == "",
		HasPrevious:  hasPrevious,
		NextCursor:   nextCursor,
		BeforeCursor: beforeCursor,
	}, nil
}
