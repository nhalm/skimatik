// list{{.StructName}}CursorState holds the resolved cursor and direction for ListPaginated.
type list{{.StructName}}CursorState struct {
	cursor         *string
	direction      string
	orderDirection string
}

// resolveList{{.StructName}}Cursor decodes the cursor (if any) and returns the
// SQL operator and ORDER BY direction to use.
func resolveList{{.StructName}}Cursor(params PaginationParams, orderBy string) (list{{.StructName}}CursorState, error) {
	switch {
	case params.BeforeCursor != "":
		cursorColumn, value, err := decodeJSONCursor(params.BeforeCursor)
		if err != nil {
			return list{{.StructName}}CursorState{}, fmt.Errorf("invalid before_cursor: %w", err)
		}
		if cursorColumn != orderBy {
			return list{{.StructName}}CursorState{}, fmt.Errorf("cursor column %q does not match order_by column %q", cursorColumn, orderBy)
		}
		cursorStr := fmt.Sprintf("%v", value)
		return list{{.StructName}}CursorState{cursor: &cursorStr, direction: "<", orderDirection: "DESC"}, nil
	case params.NextCursor != "":
		cursorColumn, value, err := decodeJSONCursor(params.NextCursor)
		if err != nil {
			return list{{.StructName}}CursorState{}, fmt.Errorf("invalid next_cursor: %w", err)
		}
		if cursorColumn != orderBy {
			return list{{.StructName}}CursorState{}, fmt.Errorf("cursor column %q does not match order_by column %q", cursorColumn, orderBy)
		}
		cursorStr := fmt.Sprintf("%v", value)
		return list{{.StructName}}CursorState{cursor: &cursorStr, direction: ">", orderDirection: "ASC"}, nil
	default:
		return list{{.StructName}}CursorState{direction: ">", orderDirection: "ASC"}, nil
	}
}

// normalizeList{{.StructName}}Params clamps the limit and applies the default
// order-by column for ListPaginated.
func normalizeList{{.StructName}}Params(params PaginationParams) (limit int, orderBy string, err error) {
	limit = params.Limit
	if limit <= 0 {
		limit = 20
	}
	if limit > 100 {
		limit = 100
	}

	orderBy = params.OrderBy
	if orderBy == "" {
		orderBy = "{{.IDColumn}}"
	}

	if err := validateOrderByColumn(orderBy, []string{"{{.IDColumn}}"}); err != nil {
		return 0, "", err
	}
	return limit, orderBy, nil
}

// buildList{{.StructName}}Result assembles the final PaginationResult, generating
// next/before cursors and reversing items if backward pagination was used.
func buildList{{.StructName}}Result(items []{{.StructName}}, orderBy string, params PaginationParams, hasMore bool) *PaginationResult[{{.StructName}}] {
	// If we paginated backward, reverse the results
	if params.BeforeCursor != "" {
		for i, j := 0, len(items)-1; i < j; i, j = i+1, j-1 {
			items[i], items[j] = items[j], items[i]
		}
	}

	var nextCursor, beforeCursor string
	if len(items) > 0 {
		firstItem := items[0]
		lastItem := items[len(items)-1]

		if hasMore && params.BeforeCursor == "" {
			formattedValue := formatCursorValue(lastItem.GetID())
			nextCursor, _ = encodeJSONCursor(orderBy, formattedValue)
		}

		if params.NextCursor != "" || params.BeforeCursor != "" {
			formattedValue := formatCursorValue(firstItem.GetID())
			beforeCursor, _ = encodeJSONCursor(orderBy, formattedValue)
		}

		if hasMore && params.BeforeCursor != "" {
			formattedValue := formatCursorValue(firstItem.GetID())
			beforeCursor, _ = encodeJSONCursor(orderBy, formattedValue)
		}
	}

	hasPrevious := params.NextCursor != "" || (params.BeforeCursor != "" && hasMore)

	return &PaginationResult[{{.StructName}}]{
		Items:        items,
		HasMore:      hasMore && params.BeforeCursor == "",
		HasPrevious:  hasPrevious,
		NextCursor:   nextCursor,
		BeforeCursor: beforeCursor,
	}
}

// ListPaginated retrieves {{.StructName}}s with cursor-based pagination
func (r *{{.RepositoryName}}) ListPaginated(ctx context.Context, db pgxkit.Executor, params PaginationParams) (*PaginationResult[{{.StructName}}], error) {
	// Validate parameters
	if err := validatePaginationParams(params); err != nil {
		return nil, err
	}

	limit, orderBy, err := normalizeList{{.StructName}}Params(params)
	if err != nil {
		return nil, err
	}

	// Determine direction and cursor
	state, err := resolveList{{.StructName}}Cursor(params, orderBy)
	if err != nil {
		return nil, err
	}

	// Build the query
	query := fmt.Sprintf(`
		SELECT {{.SelectColumns}}
		FROM {{.TableName}}
		WHERE ($1::text IS NULL OR %s %s $1::%s)
		ORDER BY %s %s
		LIMIT $2
	`, orderBy, state.direction, "{{.IDColumnType}}", orderBy, state.orderDirection)

	// Execute query with limit + 1 to check if there are more items
	rows, err := ExecuteReadQuery(ctx, db, "list_paginated", "{{.StructName}}", query, state.cursor, int32(limit+1))
	if err != nil {
		return nil, fmt.Errorf("pagination query failed: %w", err)
	}
	defer rows.Close()

	var items []{{.StructName}}
	for rows.Next() {
		var {{.ReceiverName}} {{.StructName}}
		err := rows.Scan({{.ScanArgs}})
		if err != nil {
			return nil, HandleDatabaseError("scan", "{{.StructName}}", err)
		}
		items = append(items, {{.ReceiverName}})
	}

	if err := HandleRowsResult("{{.StructName}}", rows); err != nil {
		return nil, err
	}

	// Check if there are more items
	hasMore := len(items) > limit
	if hasMore {
		items = items[:limit]
	}

	return buildList{{.StructName}}Result(items, orderBy, params, hasMore), nil
}
